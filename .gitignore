# Source code, configurations, documentation, OpenFAST templates and small result files are tracked.
# Data, caches, OpenFAST binaries and outputs, and large intermediate results are not.

# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.ipynb_checkpoints/

# Environments
.venv/
venv/
env/
.env/

# OS and editors
.DS_Store
__MACOSX/
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo

# Data (see data/README.md) and caches
data/*
!data/README.md
cache/

# Generated results (see results/README.md)
results/*/intermediate/
results/tables/
results/figures/

# OpenFAST executables, baseline files, wind fields and simulation outputs (see openfast/README.md)
*.dll
*.exe
*.so
*.dylib
openfast/baseline/5MW_Baseline/
*.out
*.outb
*.lin
*.ech
*.sum
*.vtk
*.vtp
*.vtm
*.vtu
*.bts
*.wnd
*.hh
*.coh
outputs/
outputs_lin/
outputs_*/
